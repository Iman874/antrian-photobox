# ============================================================
# Environment Variables - Antrian Photobox
# ============================================================
# Copy file ini jadi .env dan sesuaikan nilainya
#
# LOKAL (Development):
#   Tidak perlu set apa-apa, langsung `node server.js`
#   Default: localhost, root, no password, antrian_photobox
#
# cPANEL (Production):
#   Set NODE_ENV=production, atau set DB_* satu per satu
# ============================================================

# Set ke 'production' untuk pakai config cPanel
NODE_ENV=development

# Override database config (opsional, override NODE_ENV)
# DB_HOST=localhost
# DB_USER=root
# DB_PASS=
# DB_NAME=antrian_photobox

# Port server (default: 3000)
# PORT=3000
